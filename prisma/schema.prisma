generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name   String
  email  String
  phone  String?
  topic  String      // "sales" | "support" | "partnership" | "general"
  message String

  source  String?    // e.g., "homepage-hero", "contact-page"
  resolved Boolean   @default(false)
}

// User model for review system
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  avatar      String?
  preferences String?  // JSON string for user preferences
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]
  helpfulness ReviewHelpfulness[]
  verificationLogs ReviewVerificationLog[]
  itineraries Itinerary[]
}

// Review categories for different entity types
model ReviewCategory {
  id         String   @id
  name       String
  entityType String   // "poi", "restaurant", "hotel", "emergency_service"
  weight     Float    @default(1.0)
  
  reviewRatings ReviewRating[]
  
  @@map("review_categories")
}

// Main reviews table
model Review {
  id          String   @id @default(cuid())
  userId      String
  entityType  String   // "poi", "restaurant", "hotel", "emergency_service"
  entityId    String
  rating      Float    // 1.0 to 5.0
  title       String?
  content     String?
  photos      String?  // JSON string array of photo URLs for SQLite compatibility
  helpfulCount Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  user         User           @relation(fields: [userId], references: [id])
  ratings      ReviewRating[]
  helpfulness  ReviewHelpfulness[]
  verificationLogs ReviewVerificationLog[]

  @@map("reviews")
}

// Category-specific ratings
model ReviewRating {
  id         String @id @default(cuid())
  reviewId   String
  categoryId String
  rating     Float  // 1.0 to 5.0

  review   Review         @relation(fields: [reviewId], references: [id])
  category ReviewCategory @relation(fields: [categoryId], references: [id])

  @@map("review_ratings")
}

// Review helpfulness voting
model ReviewHelpfulness {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@map("review_helpfulness")
}

// Review verification logs for audit trail
model ReviewVerificationLog {
  id       String   @id @default(cuid())
  reviewId String
  adminId  String
  action   String   // "verified" or "unverified"
  reason   String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
  admin  User   @relation(fields: [adminId], references: [id])

  @@map("review_verification_logs")
}

// Destination model for travel locations
model Destination {
  id              String   @id
  name            String
  state           String
  country         String
  description     String
  bestTimeToVisit String
  averageDuration String
  coordinates     String   // JSON string for coordinates [lat, lng]
  popularFor      String   // JSON string array of popular categories
  budget          String   // JSON string for budget ranges
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities Activity[]
  itineraries Itinerary[]

  @@map("destinations")
}

// Activity model for things to do at destinations
model Activity {
  id           String   @id
  destinationId String
  name         String
  category     String   // "sightseeing", "dining", "shopping", "culture", "adventure", "nature", etc.
  description  String
  duration     String
  cost         Int      // Cost in rupees
  timeSlots    String   // JSON string array of available time slots
  highlights   String   // JSON string array of activity highlights
  coordinates  String   // JSON string for coordinates [lat, lng]
  rating       Float    // 1.0 to 5.0
  tips         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])

  @@map("activities")
}

// Itinerary model for trip plans
model Itinerary {
  id            String   @id
  destinationId String
  userId        String?  // Optional user ID for user-created itineraries
  duration      String
  travelers     String
  budget        String
  interests     String   // JSON string array of interests
  title         String
  description   String
  days          String   // JSON string of days array
  accommodation  String   // JSON string of accommodation details
  transport     String   // JSON string of transport details
  totalCost     Int      // Total cost in rupees
  isSample      Boolean  @default(false) // Flag for sample itineraries
  isPublic      Boolean  @default(true) // Whether itinerary is publicly visible
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@map("itineraries")
}
